{
    "configuration": {
        "device": {
            "orientation": "landscape",
            "deviceName": "Desktop"
        }
    },
    "type": "clickpath",
    "version": "1.0",
    "events": [
        {
            "description": "Loading of \"http://localhost/maintenance-request-system/profile.php\"",
            "wait": {
                "waitFor": "page_complete"
            },
            "target": {},
            "type": "navigate",
            "url": "http://localhost/maintenance-request-system/profile.php"
        },
        {
            "description": "click",
            "wait": {
                "waitFor": "page_complete"
            },
            "target": {
                "locators": [
                    {
                        "type": "css",
                        "value": "a:contains(\"Edit Profile\")"
                    }
                ]
            },
            "type": "click",
            "button": 0
        },
        {
            "description": "Loading of \"http://localhost/maintenance-request-system/EditProfile.php\"",
            "wait": {
                "waitFor": "page_complete"
            },
            "target": {},
            "type": "navigate",
            "url": "http://localhost/maintenance-request-system/EditProfile.php"
        },
        {
            "description": "click",
            "wait": {
                "waitFor": "page_complete"
            },
            "target": {
                "locators": [
                    {
                        "type": "css",
                        "value": "#name"
                    }
                ]
            },
            "type": "click",
            "button": 0
        },
        {
            "description": "type JS test ",
            "wait": {
                "waitFor": "page_complete"
            },
            "target": {
                "locators": [
                    {
                        "type": "css",
                        "value": "#name"
                    }
                ]
            },
            "type": "keystrokes",
            "textValue": "JS test ",
            "simulateBlurEvent": true,
            "masked": false
        },
        {
            "description": "click",
            "wait": {
                "waitFor": "page_complete"
            },
            "target": {
                "locators": [
                    {
                        "type": "dom",
                        "value": "document.evaluate('//button[@type=\\'submit\\']', document, null, XPathResult.ANY_TYPE, null).iterateNext()"
                    }
                ]
            },
            "type": "click",
            "button": 0
        },
        {
            "description": "Loading of \"http://localhost/maintenance-request-system/profile.php\"",
            "wait": {
                "waitFor": "page_complete"
            },
            "target": {},
            "type": "navigate",
            "url": "http://localhost/maintenance-request-system/profile.php",
            "validate": [
                {
                    "type": "element_match",
                    "failIfFound": false,
                    "isRegex": false,
                    "target": {
                        "locators": [
                            {
                                "type": "css",
                                "value": "dl dd:first-of-type"
                            }
                        ]
                    },
                    "match": "JS test"
                }
            ]
        }
    ]
}