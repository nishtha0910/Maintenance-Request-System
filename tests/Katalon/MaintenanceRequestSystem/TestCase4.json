        {
            "description": "type NiajjV98",
            "wait": {
                "waitFor": "page_complete"
            },
            "target": {
                "locators": [
                    {
                        "type": "css",
                        "value": "#confirm_password"
                    }
                ]
            },
            "type": "keystrokes",
            "textValue": "NiajjV98",
            "simulateBlurEvent": true,
            "masked": false
        },
        {
            "description": "send keys",
            "wait": {
                "waitFor": "page_complete"
            },
            "target": {},
            "type": "javascript",
            "javaScript": "\n                const keys = [13];\n                const elem = typeof $ !== 'undefined' ? $('#confirm_password')[0] : document.querySelector('#confirm_password');\n                keys.forEach((key) => {\n                    let eventObj = document.createEvent(\"Events\");\n                    eventObj.initEvent(\"keydown\", true, true);\n                    eventObj.key = key;\n                    eventObj.keyCode = key;\n                    eventObj.which = key;\n                    eventObj.charCode = key;\n                    \n                    elem.dispatchEvent(eventObj);\n                    eventObj = document.createEvent(\"Events\");\n                    eventObj.initEvent(\"keypress\", true, true);\n                    eventObj.key = key;\n                    eventObj.keyCode = key;\n                    eventObj.which = key;\n                    eventObj.charCode = key;\n                    elem.dispatchEvent(eventObj);\n                    \n                    eventObj = document.createEvent(\"Events\");\n                    eventObj.initEvent(\"keyup\", true, true);\n                    eventObj.key = key;\n                    eventObj.keyCode = key;\n                    eventObj.which = key;\n                    eventObj.charCode = key;\n                    elem.dispatchEvent(eventObj);\n                });"
        }
