        {
          "name": "API-04 Update Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Profile update returns 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response confirms the requested changes\", function () {\r\n    const sent = JSON.parse(\r\n        pm.variables.replaceIn(pm.request.body.raw)\r\n    );\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(data.message).to.eql(\"Profile updated successfully.\");\r\n    pm.expect(data.profile.name).to.eql(sent.name);\r\n    pm.expect(data.profile.email).to.eql(sent.email);\r\n    pm.expect(data.profile.role).to.eql(\"tenant\");\r\n    pm.expect(data.profile).not.to.have.property(\"password\");\r\n});"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": false,
            "followRedirects": true,
            "protocolVersion": "auto",
            "strictSSL": false
          },
