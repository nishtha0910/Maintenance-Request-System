        {
          "name": "API-03 View Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Profile returns 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Profile belongs to the logged-in account\", function () {\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(data.profile.email).to.eql(\"api-test-01@example.com\");\r\n    pm.expect(data.profile.role).to.eql(\"tenant\");\r\n    pm.expect(data.profile).not.to.have.property(\"password\");\r\n});\r\n\r\npm.test(\"Profile returns a CSRF token\", function () {\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(data.csrf_token).to.match(/^[a-f0-9]{64}$/);\r\n    pm.collectionVariables.set(\"csrf_token\", data.csrf_token);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost/maintenance-request-system/api/profile.php",
              "protocol": "http",
              "host": [
